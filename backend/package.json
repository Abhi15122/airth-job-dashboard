{
  "name": "airth-job-dashboard-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --watch -r ts-node/register src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
